<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#FF8964</item>
        <item name="android:windowBackground">#0B0F15</item>
        <item name="android:windowNoTitle">true</item>
        <!-- 弹窗配色：这台 ROM 强制对话框浅色面板（ContextThemeWrapper 也被无视），
             所以走「浅面板 + 黑字」：框架 AlertDialog 的标题/列表/按钮文字全部深色，
             自定义视图（tvTools.label 等）的显式白字也已改黑。 -->
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>
    <style name="AppDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#D9541E</item>
        <item name="android:colorPrimary">#D9541E</item>
        <item name="android:colorControlActivated">#D9541E</item>
        <item name="android:textColorPrimary">#1A1D24</item>
        <item name="android:textColorSecondary">#4A5568</item>
        <item name="android:textColor">#1A1D24</item>
        <!-- setItems 列表（长按卡片菜单等）用这个属性，不用 textColorPrimary——不设就是 ROM 默认白色。 -->
        <item name="android:textColorAlertDialogListItem">#1A1D24</item>
    </style>
</resources>
